<demo-block title="{{I18n.t('basicUsage')}}">
  <smart-picker
    item-height="{{ isA11y ? 52 : 44 }}"
    active-index="{{ activeIndex }}"
    change-animation
    columns="{{ column1 }}"
    bind:change="onChange1"
  />
</demo-block>

<demo-block title="{{I18n.t('multipleUsage')}}">
  <smart-picker
    item-height="{{ isA11y ? 52 : 44 }}"
    columns="{{ column5 }}"
    active-style="color: rgb(135, 180, 244);"
    bind:change="onChange1"
    custom-class="picker5"
    bind:animation-start="animationStart"
    bind:animation-end="animationEnd"
  />
</demo-block>

<demo-block title="{{I18n.t('loop')}}">
  <smart-picker
    loop
    item-height="{{ isA11y ? 52 : 44 }}"
    columns="{{ column7 }}"
    bind:change="onChange1"
  />
</demo-block>

<demo-block title="{{I18n.t('defaultSelectedItem')}}">
  <smart-picker
    columns="{{ column1 }}"
    item-height="{{ isA11y ? 52 : 44 }}"
    default-index="{{ 2 }}"
    bind:change="onChange1"
  />
</demo-block>

<demo-block title="{{I18n.t('showTheTopBar')}}">
  <smart-picker
    show-toolbar
    item-height="{{ isA11y ? 52 : 44 }}"
    title="{{I18n.t('title')}}"
    columns="{{ column1 }}"
    bind:change="onChange1"
    bind:confirm="onConfirm"
    bind:cancel="onCancel"
  />
</demo-block>

<demo-block title="{{I18n.t('multipleColumnsLinkage')}}">
  <smart-picker
    item-height="{{ isA11y ? 52 : 44 }}"
    columns="{{ column4 }}"
    bind:change="onChange2"
  />
</demo-block>

<demo-block title="{{I18n.t('disableOption')}}">
  <smart-picker columns="{{ column2 }}" item-height="{{ isA11y ? 52 : 44 }}" bind:change="onChange1" />
</demo-block>

<demo-block title="{{I18n.t('loading')}}">
  <smart-picker
    loading
    columns="{{ column4 }}"
    item-height="{{ isA11y ? 52 : 44 }}"
  />
</demo-block>

<demo-block title="{{I18n.t('setTheOrderOfColumnStyles')}}">
  <smart-picker
    item-height="{{ isA11y ? 52 : 44 }}"
    columns="{{ column6 }}"
  />
</demo-block>


<demo-block title="{{I18n.t('bigDataUsage')}}">
  <view wx:if="{{ !bigColumn.length }}" class="big-data-btn" bind:tap="loadBigData">加载 10w 选项</view>
  <block wx:else>
    <view class="big-data-tip">options.length = {{ bigColumn.length }}，注入耗时 {{ bigDataCost }}ms（子列仅接收 1000 条窗口切片，滚动停稳后自动回中）</view>
    <smart-picker
      item-height="{{ isA11y ? 52 : 44 }}"
      columns="{{ bigColumn }}"
      default-index="{{ 50000 }}"
      bind:change="onChange1"
    />
  </block>
</demo-block>

<demo-block title="{{I18n.t('more3d')}}">
  <smart-picker
    loop
    fullHeight
    item-height="{{ isA11y ? 52 : 44 }}"
    columns="{{ column7 }}"
    bind:change="onChange1"
  />
</demo-block>

<smart-toast id="smart-toast-picker" />
