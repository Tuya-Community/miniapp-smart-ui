<wxs src="../wxs/utils.wxs" module="utils" />
<wxs src="./index.wxs" module="computed" />
<view wx:if="{{inited && display}}" class="smart-popup-host" style="z-index:{{zIndex}};">
  <view wx:if="{{overlay}}" class="smart-popup-mask" style="{{overlayStyle}}" bind:tap="onClickOverlay" catch:touchmove="{{lockScroll ? 'noop' : ''}}" />
  <include src="./popup.wxml" />
</view>
