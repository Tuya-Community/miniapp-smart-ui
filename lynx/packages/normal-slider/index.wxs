function ratio(value,min,max,reverse){var n=max>min?Math.max(0,Math.min(1,(value-min)/(max-min))):0;return reverse?1-n:n;}
function track(direction,style,disabled){return 'position:relative;border-radius:999px;background-color:var(--slider-inactive-background-color,#d8d9dc);'+(direction==='vertical'?'width:4px;height:100%;':'width:100%;height:4px;')+(disabled?'opacity:0.4;':'')+(style||'');}
function bar(p){var r=ratio(p.nativeValue,p.min,p.max,false)*100;return 'position:absolute;border-radius:inherit;background-color:var(--slider-active-background-color,#1989fa);'+(p.direction==='vertical'?(p.reverse?'bottom:0;':'top:0;')+'left:50%;transform:translateX(-50%);width:100%;height:'+r+'%;':(p.reverse?'right:0;':'left:0;')+'top:50%;transform:translateY(-50%);height:100%;width:'+r+'%;')+(p.barStyle||'')+';'+(p.direction==='vertical'?'height:'+r+'%;':'width:'+r+'%;');}
function thumb(p){var r=ratio(p.nativeValue,p.min,p.max,p.reverse);var vertical=p.direction==='vertical';var inset=p.parcel?((vertical?p.parcelThumbHeight:p.parcelThumbWidth)||20)/2+(p.parcelMargin||0):0;var pos='calc('+(r*100)+'% + '+(inset*(1-2*r))+'px)';return 'position:absolute;width:28px;height:28px;background-color:#fff;border-radius:50%;box-shadow:0 2px 5px rgba(0,0,0,0.15);'+(p.thumbStyle||'')+';'+(vertical?'left:50%;top:'+pos+';':'top:50%;left:'+pos+';')+'transform:translate(-50%,-50%);';}
function tick(p){var r=ratio(p.value,p.min,p.max,p.reverse)*100;return 'position:absolute;width:4px;height:4px;border-radius:50%;background-color:#ccc;'+(p.stepStyle||'')+';'+(p.value<=p.nativeValue?(p.activeStepStyle||'background-color:#fff;'):'')+';'+(p.direction==='vertical'?'left:50%;top:'+r+'%;':'top:50%;left:'+r+'%;')+'transform:translate(-50%,-50%);';}
module.exports={track:track,bar:bar,thumb:thumb,tick:tick};
