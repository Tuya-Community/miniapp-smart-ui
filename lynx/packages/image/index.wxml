<wxs src="../wxs/utils.wxs" module="utils" />
<wxs src="./index.wxs" module="computed" />

<view
  style="{{ computed.rootStyle({ width, height, radius }) }}"
  class="custom-class {{ utils.bem('image', { round })}}"
  bind:tap="onClick"
>
  <image
    wx:if="{{ !error && sourceKind === 'bitmap' }}"
    src="{{ src }}"
    mode="{{ computed.mode(fit) }}"
    lazy-load="{{ lazyLoad }}"
    style="{{ computed.bitmapStyle({fit, bitmapWidth, bitmapHeight, tintColor}) }}"
    webp="{{ webp }}"
    class="image-class smart-image__img"
    show-menu-by-longpress="{{ showMenuByLongpress }}"
    bind:load="onLoad"
    bind:error="onError"
  />
  <svg-render wx:if="{{!error && svgDataUri && computed.svgSource(svgDataUri, tintColor, themeColors)}}" source="{{computed.svgSource(svgDataUri, tintColor, themeColors)}}" class="image-class smart-image__img" />
  <view
    wx:if="{{ tintColor && !error && sourceKind === 'bitmap' }}"
    class="image-class smart-image__img smart-image__tint-color"
    style="{{ computed.maskStyle(src, tintColor) }}"
  ></view>
  <view
    wx:if="{{ loading && showLoading }}"
    class="loading-class smart-image__loading"
  >
    <slot wx:if="{{ useLoadingSlot }}" name="loading" />
    <smart-icon wx:else name="{{ loadingSvg }}" color="var(--image-loading-icon-color, #dcdee0)" custom-class="smart-image__loading-icon" />
  </view>
  <view
    wx:if="{{ error && showError }}"
    class="error-class smart-image__error"
  >
    <slot wx:if="{{ useErrorSlot }}" name="error" />
    <image wx:else src="{{ computed.defaultErrorImg }}" class="smart-image__error-img" />
  </view>
</view>
