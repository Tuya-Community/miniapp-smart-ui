/* eslint-disable */
var style = require('../wxs/style.wxs');
var addUnit = require('../wxs/add-unit.wxs');
var svg = require('../icon/svg.wxs');
/* eslint-disable */
var defaultErrorImg = "data:image/png;base64,"

function rootStyle(data) {
  return style([
    {
      width: addUnit(data.width),
      height: addUnit(data.height),
      'border-radius': addUnit(data.radius),
    },
    data.radius ? 'overflow: hidden' : null,
  ]);
}

var FIT_MODE_MAP = {
  none: 'center',
  fill: 'scaleToFill',
  cover: 'aspectFill',
  contain: 'aspectFit',
  widthFix: 'widthFix',
  heightFix: 'heightFix',
};

function mode(fit) {
  return FIT_MODE_MAP[fit];
}


function maskStyle(url, color) {
  var str = 'mask-image: url(' + url + ');background-color: ' + color + ';'
  return str
}

function bitmapStyle(data) {
  var result = data.tintColor ? 'visibility:hidden;' : '';
  if (data.bitmapWidth > 0 && data.bitmapHeight > 0) {
    if (data.fit === 'widthFix') result += 'height:auto;align-self:flex-start;flex-shrink:0;aspect-ratio:' + (data.bitmapWidth / data.bitmapHeight) + ';';
    if (data.fit === 'heightFix') result += 'width:auto;align-self:flex-start;flex-shrink:0;aspect-ratio:' + (data.bitmapWidth / data.bitmapHeight) + ';';
  }
  return result;
}

module.exports = {
  bitmapStyle: bitmapStyle,
  rootStyle: rootStyle,
  mode: mode,
  defaultErrorImg: defaultErrorImg,
  isSvg: function (src) { return (src || '').indexOf('data:image/svg+xml') === 0; },
  svgSource: function (src, color, themeColors) { return svg.getSource({ name: src, color: color, themeColors: themeColors, preserveDefaultFill: !color }); },
  maskStyle: maskStyle
};
