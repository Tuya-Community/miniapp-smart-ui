<view class="smart-calendar__header">
  <block wx:if="{{ showTitle }}">
    <view class="smart-calendar__header-title" style="height:auto"><slot name="title"></slot></view>
    <view class="smart-calendar__header-title">
      <text>{{ title }}</text>
      <view class="smart-calendar__header-title-save" bind:tap="onSave" wx:if="{{showConfirm}}"><text>{{ rightText }}</text></view>
    </view>
  </block>

  <view class="smart-calendar__header-subtitle_wrap">
    <view class="smart-calendar__header-subtitle_left" bind:tap="onPrev">
      <smart-icon color="{{iconColor}}" class="smart-calendar__header-subtitle_left_icon" name="{{LeftIcon}}" size="16px" />
    </view>
    <view wx:if="{{ showSubtitle }}" class="smart-calendar__header-subtitle smart-manrope" bind:tap="onClickSubtitle">
      <text>{{ subtitle }}</text>
    </view>
    <view class="smart-calendar__header-subtitle_right" bind:tap="onNext">
      <smart-icon color="{{iconColor}}" class="smart-calendar__header-subtitle_right_icon" name="{{RightIcon}}" size="16px" />
    </view>
  </view>

  <view class="smart-calendar__weekdays" wx:if="{{!hideWeek}}">
    <view wx:for="{{ weekdays }}" wx:key="index" class="smart-calendar__weekday">
      <text>{{ item }}</text>
    </view>
  </view>
</view>
