<wxs src="./index.wxs" module="computed" />

<view
  class="{{ computed.rootClass({ classPrefix, name }) }}"
  style="{{ computed.rootStyle({ customStyle, color, size }) }}"
  bindtap="onClick"
  role="{{ ariaRole }}"
  aria-role="{{ ariaRole }}"
  aria-label="{{ ariaLabel }}"
>
  <view
    wx:if="{{ computed.isNative() && (info !== null && info !== '' || dot) }}"
    class="smart-icon__native-info{{ dot ? ' smart-icon__native-info--dot' : '' }} smart-icon__info info-class"
  ><text wx:if="{{ !dot }}" class="smart-icon__native-info-text">{{ info }}</text></view>
  <smart-info
    wx:elif="{{ !computed.isNative() && (info !== null || dot) }}"
    dot="{{ dot }}"
    info="{{ info }}"
    custom-class="smart-icon__info info-class"
  />
  <svg-render
    wx:if="{{ computed.isNativeSvg(name) && computed.nativeSvgSource({ name, color, customStyle, themeColors }) }}"
    source="{{ computed.nativeSvgSource({ name, color, customStyle, themeColors }) }}"
    class="smart-icon__native-svg"
  />
  <view
    wx:elif="{{ computed.isSvg(name) }}"
    style="{{ computed.svgStyle({ customStyle, name, color }) }}"
    class="smart-icon__svg"
  />
  <image
    wx:elif="{{ computed.isImage(name) }}"
    src="{{ computed.getImageSrc({ name, color }) }}"
    mode="aspectFit"
    class="smart-icon__image"
  />
  <view
    wx:elif="{{ computed.isSvgPath(name) }}"
    style="{{ computed.svgPathStyle({ customStyle, name, color }) }}"
    class="smart-icon__svg"
  />
</view>
