function getMark(date) { return date ? date.month : ''; }
var ROW_HEIGHT = 64;
function getDayStyle(type, index, date, rowHeight, color, firstDayOfWeek) {
  var style = [];
  var current = (date && date.weekday) || 7;
  var offset = current < firstDayOfWeek ? 7 - firstDayOfWeek + current : current === 7 && firstDayOfWeek === 0 ? 0 : current - firstDayOfWeek;
  if (index === 0) style.push(['margin-left', (100 * offset) / 7 + '%']);
  if (rowHeight && rowHeight !== ROW_HEIGHT) style.push(['height', rowHeight + 'px']);
  if (color && (type === 'start' || type === 'end' || type === 'start-end' || type === 'multiple-selected' || type === 'multiple-middle' || type === 'middle')) style.push(['background', color]);
  return style.map(function(item) { return item.join(':'); }).join(';');
}
function formatMonthTitle(date, formatter) {
  if (!date) return '';
  return (formatter || 'YYYY-MM').replace('YYYY', date.year + '').replace('MM', date.month < 10 ? '0' + date.month : date.month + '');
}
function getMonthStyle(visible, date, rowHeight) {
  if (!visible && date) return 'padding-bottom:' + Math.ceil((date.days + date.weekday) / 7) * rowHeight + 'px';
}
module.exports = { getMark:getMark, getDayStyle:getDayStyle, formatMonthTitle:formatMonthTitle, getMonthStyle:getMonthStyle };
