<wxs src="../wxs/utils.wxs" module="utils" />
<wxs src="./index.wxs" module="computed" />
<block wx:if="{{ isShowed }}">
  <!-- One native host owns both layers, so teardown cannot leave an orphan mask. -->
  <view wx:if="{{ overlay }}" class="smart-lynx-popup-host" style="position:fixed;top:0;bottom:0;left:0;right:0;z-index:{{ zIndex }};">
    <smart-overlay show="{{ show }}" z-index="{{ zIndex }}" custom-style="{{ overlayStyle }}" duration="{{ duration }}" bind:click="onClickOverlay" lock-scroll="{{ lockScroll }}" />
    <include src="./popup.wxml" />
  </view>
  <include wx:else src="./popup.wxml" />
</block>
